{
    "listen": "127.0.0.1:8080",
    "upstreams": {
        "codex": {
            "base_url": "https://api.openai.com/v1",
            "protocol": "responses",
            "auth": { "provider": "codex" }
        },
        "go": {
            "base_url": "https://opencode.ai/zen/go/v1",
            "protocol": "chat_completions",
            "auth": { "provider": "api_key", "key_env": "OPENCODE_GO_KEY" }
        },
        "zen": {
            "base_url": "https://opencode.ai/zen/v1",
            "protocol": "chat_completions",
            "auth": { "provider": "api_key", "key_env": "OPENCODE_ZEN_KEY" }
        }
    },
    "clients": {
        "pi": {
            "key_env": "FUMO_PI_KEY"
        }
    }
}
