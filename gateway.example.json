{
    "$schema": "https://raw.githubusercontent.com/sleroq/fumo-gateway/main/schemas/v1/gateway.schema.json",
    "listen": "127.0.0.1:8080",
    "admin": { "key_env": "FUMO_ADMIN_KEY" },
    "upstreams": {
        "codex": {
            "base_url": "https://api.openai.com/v1",
            "auth": { "provider": "codex" }
        },
        "go": {
            "base_url": "https://opencode.ai/zen/go/v1",
            "auth": { "provider": "api_key", "key_env": "OPENCODE_GO_KEY" }
        },
        "zen": {
            "base_url": "https://opencode.ai/zen/v1",
            "auth": { "provider": "api_key", "key_env": "OPENCODE_ZEN_KEY" }
        }
    },
    "clients": {
        "pi": {
            "key_env": "FUMO_PI_KEY"
        }
    }
}
