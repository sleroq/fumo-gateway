{
  "name": "@fumo-gateway/pi",
  "version": "1.2.1",
  "description": "Fumo gateway model discovery for Pi's native OpenAI adapters",
  "type": "module",
  "keywords": [
    "pi-package",
    "fumo"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "bun ../build.ts pi",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "typebox": "^1.4.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
