{
  "name": "@fumo-gateway/opencode",
  "version": "1.0.0",
  "description": "Fumo gateway discovery and native HTTP adapters for OpenCode V2",
  "type": "module",
  "files": ["server.js", "dist"],
  "exports": {
    ".": { "types": "./dist/opencode/server.d.ts", "default": "./server.js" },
    "./server": { "types": "./dist/opencode/server.d.ts", "default": "./server.js" }
  },
  "scripts": {
    "build": "bun ../build.ts opencode",
    "prepack": "bun run build"
  },
  "dependencies": { "typebox": "1.3.27" },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4",
    "effect": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "effect": { "optional": true }
  },
  "publishConfig": { "access": "public" }
}
