{
    "name": "fumo-admin",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun --bun vite --host 127.0.0.1",
        "typecheck": "bun --bun tsc -b",
        "lint": "bun --bun oxlint src vite.config.ts tests",
        "build": "bun run typecheck && bun --bun vite build",
        "preview": "bun --bun vite preview --host 127.0.0.1",
        "test": "bun test tests/browser.test.ts",
        "test:browser": "bun run test"
    },
    "dependencies": {
        "solid-js": "2.0.0-rc.20",
        "@solidjs/web": "2.0.0-rc.20"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "3.0.0-next.53",
        "@solidjs/compiler": "2.0.0-rc.20",
        "@solidjs/babel-plugin": "2.0.0-rc.20",
        "@types/node": "^24.19.2",
        "@types/bun": "latest",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "oxlint": "latest",
        "playwright": "latest"
    }
}
